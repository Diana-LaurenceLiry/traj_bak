<launch>
  <param name="/use_sim_time" value="true"/>

  <!-- core args -->
  <arg name="robot_urdf" default="/home/lry/catkin_ws/src/my_gazebo_sim/urdf/simple_diffbot_stereo_fixed_optical.urdf"/>
  <arg name="use_sim_bridge" default="true"/>
  <arg name="use_imu" default="false"/>
  <arg name="world_name" default="$(find my_gazebo_sim)/worlds/nav_obstacle.world"/>
  <arg name="use_rviz" default="true"/>
  <arg name="rviz_config" default="/home/lry/catkin_ws/src/my_gazebo_sim/gazebo_nav.rviz"/>

  <!-- ORB-SLAM3 args -->
  <arg name="voc_file" default="/home/lry/ORB_SLAM3/Vocabulary/ORBvoc.txt"/>
  <arg name="settings_file" default="/home/lry/ORB_SLAM3/Examples/ROS/ORB_SLAM3/gazebo_camera_from_urdf.yaml"/>

  <!-- navigation args -->
  <arg name="map_topic" default="/occupancy_map"/>
  <arg name="map_frame" default="odom"/>
  <arg name="use_relative_height_filter" default="true"/>
  <arg name="robot_frame" default="base_link"/>
  <arg name="rel_min_z" default="-0.08"/>
  <arg name="rel_max_z" default="0.45"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="goal_topic" default="/move_base_simple/goal"/>
  <arg name="path_topic" default="/global_path"/>
  <arg name="cmd_topic" default="/cmd_vel"/>
  <arg name="cmd_raw_topic" default="/cmd_vel_raw"/>
  <arg name="use_obstacle_avoidance" default="true"/>
  <arg name="use_move_base" default="true"/>
  <arg name="move_base_global_planner" default="global_planner/GlobalPlanner"/>
  <arg name="move_base_local_planner" default="dwa_local_planner/DWAPlannerROS"/>

  <!-- 1) gazebo + robot (no waypoint controller, avoid cmd_vel_raw conflict) -->
  <include file="$(find my_gazebo_sim)/launch/simple_diffbot_gazebo.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="robot_urdf" value="$(arg robot_urdf)"/>
  </include>

  <!-- 2) perception pipeline -->
  <include file="$(find my_gazebo_sim)/launch/perception_pipeline.launch">
    <arg name="use_sim_bridge" value="$(arg use_sim_bridge)"/>
    <arg name="use_imu" value="$(arg use_imu)"/>
    <arg name="map_topic" value="$(arg map_topic)"/>
    <arg name="map_frame" value="$(arg map_frame)"/>
    <arg name="use_relative_height_filter" value="$(arg use_relative_height_filter)"/>
    <arg name="robot_frame" value="$(arg robot_frame)"/>
    <arg name="rel_min_z" value="$(arg rel_min_z)"/>
    <arg name="rel_max_z" value="$(arg rel_max_z)"/>
  </include>

  <!-- 3) ORB-SLAM3 stereo -->
  <node pkg="ORB_SLAM3"
        type="Stereo"
        name="stereo"
        output="screen"
        args="$(arg voc_file) $(arg settings_file) false">
    <remap from="/camera/left/image_raw" to="/camera/infra1/image_rect_raw"/>
    <remap from="/camera/right/image_raw" to="/camera/infra2/image_rect_raw"/>
  </node>

  <!-- 4A) custom minimal navigation stack (legacy) -->
  <node unless="$(arg use_move_base)"
        pkg="my_gazebo_sim"
        type="astar_global_planner.py"
        name="astar_global_planner"
        output="screen">
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="path_topic" value="$(arg path_topic)"/>
    <param name="occupancy_threshold" value="50"/>
    <param name="unknown_is_obstacle" value="false"/>
    <param name="replan_rate" value="1.0"/>
    <param name="goal_tolerance" value="0.20"/>
  </node>

  <node unless="$(arg use_move_base)"
        pkg="my_gazebo_sim"
        type="path_follower.py"
        name="path_follower"
        output="screen">
    <param name="path_topic" value="$(arg path_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="cmd_topic" value="$(arg cmd_raw_topic)"/>
    <param name="lookahead_dist" value="0.45"/>
    <param name="goal_tolerance" value="0.20"/>
    <param name="max_linear" value="0.8"/>
    <param name="max_angular" value="1.2"/>
    <param name="k_angular" value="1.8"/>
    <param name="rotate_in_place_thresh" value="0.75"/>
    <param name="control_rate" value="15.0"/>
  </node>

  <node if="$(eval arg('use_obstacle_avoidance') == 'true' and arg('use_move_base') == 'false')"
        pkg="my_gazebo_sim"
        type="obstacle_avoidance.py"
        name="obstacle_avoidance"
        output="screen">
    <param name="enabled" value="true"/>
    <param name="cmd_in_topic" value="$(arg cmd_raw_topic)"/>
    <param name="cmd_out_topic" value="$(arg cmd_topic)"/>
    <param name="map_topic" value="$(arg map_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="forward_distance" value="1.2"/>
    <param name="corridor_half_width" value="0.40"/>
    <param name="critical_distance" value="0.40"/>
    <param name="slowdown_distance" value="1.0"/>
    <param name="occupancy_threshold" value="50"/>
    <param name="unknown_is_obstacle" value="false"/>
    <param name="min_turn_rate" value="0.20"/>
    <param name="max_turn_rate" value="0.80"/>
    <param name="max_output_linear" value="0.8"/>
  </node>

  <node if="$(eval arg('use_obstacle_avoidance') == 'false' and arg('use_move_base') == 'false')"
        pkg="topic_tools"
        type="relay"
        name="cmd_vel_passthrough"
        args="$(arg cmd_raw_topic) $(arg cmd_topic)"
        output="screen"/>

  <!-- 4B) standard ROS navigation stack -->
  <node if="$(arg use_move_base)"
        pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen">
    <param name="base_global_planner" value="$(arg move_base_global_planner)"/>
    <param name="base_local_planner" value="$(arg move_base_local_planner)"/>
    <remap from="cmd_vel" to="$(arg cmd_topic)"/>
    <rosparam command="load" file="$(find my_gazebo_sim)/config/move_base_common.yaml"/>
    <rosparam command="load" file="$(find my_gazebo_sim)/config/global_costmap.yaml"/>
    <rosparam command="load" file="$(find my_gazebo_sim)/config/local_costmap.yaml"/>
    <rosparam command="load" file="$(find my_gazebo_sim)/config/dwa_local_planner.yaml"/>
  </node>

  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(arg rviz_config)"/>
</launch>
