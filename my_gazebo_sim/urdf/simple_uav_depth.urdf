<?xml version="1.0"?>
<robot name="simple_uav">

  <material name="uav_body">
    <color rgba="0.10 0.50 0.90 1.0"/>
  </material>
  <material name="uav_arm">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="uav_rotor">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="uav_accent">
    <color rgba="0.95 0.30 0.15 1.0"/>
  </material>
  <material name="cam_gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0"
               iyy="0.03" iyz="0.0"
               izz="0.05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.18 0.06"/>
      </geometry>
      <material name="uav_body"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
      <material name="uav_accent"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="arm_fl_link">
    <inertial>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="8e-5" ixy="0.0" ixz="0.0"
               iyy="8e-5" iyz="0.0"
               izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.02 0.02"/>
      </geometry>
      <material name="uav_arm"/>
    </visual>
  </link>
  <joint name="arm_fl_joint" type="fixed">
    <origin xyz="0 0 0.015" rpy="0 0 0.7854"/>
    <parent link="base_link"/>
    <child link="arm_fl_link"/>
  </joint>

  <link name="arm_fr_link">
    <inertial>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="8e-5" ixy="0.0" ixz="0.0"
               iyy="8e-5" iyz="0.0"
               izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.02 0.02"/>
      </geometry>
      <material name="uav_arm"/>
    </visual>
  </link>
  <joint name="arm_fr_joint" type="fixed">
    <origin xyz="0 0 0.015" rpy="0 0 -0.7854"/>
    <parent link="base_link"/>
    <child link="arm_fr_link"/>
  </joint>

  <link name="arm_rl_link">
    <inertial>
      <origin xyz="-0.12 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="8e-5" ixy="0.0" ixz="0.0"
               iyy="8e-5" iyz="0.0"
               izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="-0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.02 0.02"/>
      </geometry>
      <material name="uav_arm"/>
    </visual>
  </link>
  <joint name="arm_rl_joint" type="fixed">
    <origin xyz="0 0 0.015" rpy="0 0 0.7854"/>
    <parent link="base_link"/>
    <child link="arm_rl_link"/>
  </joint>

  <link name="arm_rr_link">
    <inertial>
      <origin xyz="-0.12 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="8e-5" ixy="0.0" ixz="0.0"
               iyy="8e-5" iyz="0.0"
               izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="-0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.02 0.02"/>
      </geometry>
      <material name="uav_arm"/>
    </visual>
  </link>
  <joint name="arm_rr_joint" type="fixed">
    <origin xyz="0 0 0.015" rpy="0 0 -0.7854"/>
    <parent link="base_link"/>
    <child link="arm_rr_link"/>
  </joint>

  <link name="rotor_fl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="2e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.012"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0.08 0 0.004" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0 0.08 0.004" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
  </link>
  <joint name="rotor_fl_joint" type="fixed">
    <origin xyz="0.22 0.22 0.03" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_fl_link"/>
  </joint>

  <link name="rotor_fr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="2e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.012"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0.08 0 0.004" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0 0.08 0.004" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
  </link>
  <joint name="rotor_fr_joint" type="fixed">
    <origin xyz="0.22 -0.22 0.03" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_fr_link"/>
  </joint>

  <link name="rotor_rl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="2e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.012"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0.08 0 0.004" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0 0.08 0.004" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
  </link>
  <joint name="rotor_rl_joint" type="fixed">
    <origin xyz="-0.22 0.22 0.03" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_rl_link"/>
  </joint>

  <link name="rotor_rr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="2e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.012"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0.08 0 0.004" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
    <visual>
      <origin xyz="0 0.08 0.004" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.16 0.015 0.004"/>
      </geometry>
      <material name="uav_rotor"/>
    </visual>
  </link>
  <joint name="rotor_rr_joint" type="fixed">
    <origin xyz="-0.22 -0.22 0.03" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_rr_link"/>
  </joint>

  <link name="depth_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.03"/>
      </geometry>
      <material name="cam_gray"/>
    </visual>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
  </joint>

  <link name="depth_camera_optical_frame"/>
  <joint name="depth_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="depth_camera_link"/>
    <child link="depth_camera_optical_frame"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera_sensor">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_openni_kinect.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>20.0</updateRate>
        <cameraName>depth_camera</cameraName>
        <frameName>depth_camera_optical_frame</frameName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <pointCloudCutoff>0.05</pointCloudCutoff>
        <pointCloudCutoffMax>20.0</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="uav_pose_p3d" filename="libgazebo_ros_p3d.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>odom</topicName>
      <!-- Use Gazebo world as parent frame; "odom" is not a Gazebo entity frame. -->
      <frameName>world</frameName>
      <gaussianNoise>0.0</gaussianNoise>
      <xyzOffsets>0 0 0</xyzOffsets>
      <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
  </gazebo>

</robot>
