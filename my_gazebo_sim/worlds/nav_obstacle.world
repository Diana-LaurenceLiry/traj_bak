          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner markers: alternating small cubes -->
    <model name="feature_cube_1">
      <static>true</static>
      <pose>0.8 1.1 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.12 0.16</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.12 0.16</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="feature_cube_2">
      <static>true</static>
