    <!-- Vertical poles add edge features in depth -->
    <model name="feature_pole_1">
      <static>true</static>
      <pose>1.0 -0.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
