    <model name="feature_cube_5">
      <static>true</static>
      <pose>2.2 -1.1 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.12 0.16</size></box></geometry></collision>
